{
  "name": "luna-ultra-webcam-dev",
  "version": "0.3.2-1",
  "private": true,
  "workspaces": [
    "docs/site"
  ],
  "overrides": {
    "simple-git": "4.0.2"
  },
  "type": "module",
  "scripts": {
    "build": "tauri build",
    "dev": "tauri dev",
    "ui:dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "docs:dev": "bun --cwd=docs/site run dev",
    "docs:generate": "bun --cwd=docs/site run generate",
    "postinstall": "git config core.hooksPath .githooks || true && nuxt prepare",
    "test": "vitest run && vitest run -c vitest.nuxt.config.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "fmt": "oxfmt",
    "typecheck": "nuxt typecheck",
    "changelog": "changelogen",
    "release": "bun scripts/release.mjs",
    "audit:critical": "bun audit --production --audit-level=critical"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@nuxt/ui": "^4.11.3",
    "@tauri-apps/plugin-fs": "^2.6.0",
    "@tauri-apps/plugin-http": "^2.8.0",
    "nuxt": "^4.5.2",
    "pannellum": "^2.5.7",
    "tailwindcss": "^4.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@nuxt/test-utils": "^4.3.3",
    "@tauri-apps/cli": "^2.12.1",
    "@types/three": "^0.185.4",
    "@vue/test-utils": "^2.5.1",
    "changelogen": "^0.6.2",
    "happy-dom": "^20.14.5",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.86.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.12"
  },
  "lint-staged": {
    "**/*.{js,mjs,cjs,jsx,ts,mts,cts,tsx,vue}": [
      "oxfmt",
      "oxlint --fix --deny-warnings"
    ]
  },
  "patchedDependencies": {
    "@nuxt/devtools@3.4.2": "patches/@nuxt%2Fdevtools@3.4.2.patch"
  }
}
